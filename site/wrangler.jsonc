{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The notbitlee.com landing page: static files only, no Worker code.
  "name": "notbitlee-site",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "notbitlee.com", "custom_domain": true },
    { "pattern": "www.notbitlee.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
